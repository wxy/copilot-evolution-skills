}

ensure_layout() {
  mkdir -p "$SKILLS_DIR"
  mkdir -p ".github"
}

is_evoskills_repo() {
  # Check if this is the evoskills project itself
  if [ -f "package.json" ] && grep -q '"name".*"evoskills"' package.json; then
    return 0
  fi
  return 1
}

github_raw_url() {
  local repo_url="$1"
  local path="$2"
  # Convert https://github.com/user/repo to https://raw.githubusercontent.com/user/repo/main/path
  local raw_repo
  raw_repo=$(echo "$repo_url" | sed 's|https://github.com/|https://raw.githubusercontent.com/|' | sed 's|\.git$||')
  echo "$raw_repo/main/$path"
}

github_archive_url() {
  local repo_url="$1"
  local archive_repo
  archive_repo=$(echo "$repo_url" | sed 's|https://github.com/||' | sed 's|\.git$||')
  echo "https://codeload.github.com/$archive_repo/tar.gz/refs/heads/main"
}

fingerprint_path() {
  local target_path="$1"

  if [ -f "$target_path" ]; then
    cksum "$target_path" 2>/dev/null | awk '{print $1":"$2}'
    return 0
  fi

  if [ -d "$target_path" ]; then
    (
      cd "$target_path" || exit 1
      find . -type f | LC_ALL=C sort | while read -r file; do
        cksum "$file" | awk -v name="$file" '{print name":"$1":"$2}'
      done
    ) | cksum | awk '{print $1":"$2}'
    return 0
  fi

  echo "__missing__"
}

ensure_repo_snapshot() {
  local skills_repo="$1"

  if [ "$REPO_SNAPSHOT_REPO" = "$skills_repo" ] && [ -n "$REPO_SNAPSHOT_ROOT" ] && [ -d "$REPO_SNAPSHOT_ROOT" ]; then
    return 0
  fi

  cleanup_repo_snapshot

  local snapshot_dir archive_file extract_dir snapshot_root archive_url
  snapshot_dir=$(mktemp -d)
  archive_file="$snapshot_dir/repo.tar.gz"
  extract_dir="$snapshot_dir/extract"
  archive_url=$(github_archive_url "$skills_repo")

  if ! curl -sfL "$archive_url" > "$archive_file" 2>/dev/null; then
    rm -rf "$snapshot_dir"
    return 1
  fi

  mkdir -p "$extract_dir"
  if ! tar -xzf "$archive_file" -C "$extract_dir" 2>/dev/null; then
    rm -rf "$snapshot_dir"
    return 1
  fi

  snapshot_root=$(find "$extract_dir" -mindepth 1 -maxdepth 1 -type d | head -1)
  if [ -z "$snapshot_root" ] || [ ! -d "$snapshot_root" ]; then
    rm -rf "$snapshot_dir"
    return 1
  fi

  REPO_SNAPSHOT_DIR="$snapshot_dir"
  REPO_SNAPSHOT_ROOT="$snapshot_root"
  REPO_SNAPSHOT_REPO="$skills_repo"
  return 0
}

sync_file_if_changed() {
  local source_file="$1"
  local target_file="$2"
  local label="$3"
  local before after

  if [ ! -f "$source_file" ]; then
    return 1
  fi

  before=$(fingerprint_path "$target_file")
  after=$(fingerprint_path "$source_file")

  if [ "$before" = "$after" ]; then
    print_info "Checked $label: no changes, skipped"
    return 2
  fi

  mkdir -p "$(dirname "$target_file")"
  cp "$source_file" "$target_file"
  print_success "Checked $label: updated"
  return 0
}

sync_directory_if_changed() {
  local source_dir="$1"
  local target_dir="$2"
  local label="$3"
  local before after staging_dir staged_target

  if [ ! -d "$source_dir" ]; then
    return 1
  fi

  before=$(fingerprint_path "$target_dir")
  after=$(fingerprint_path "$source_dir")

  if [ "$before" = "$after" ]; then
    print_info "Checked $label: no changes, skipped"
    return 2
  fi

  staging_dir=$(mktemp -d)
  staged_target="$staging_dir/$(basename "$target_dir")"
  cp -R "$source_dir" "$staged_target"

  rm -rf "$target_dir"
  mkdir -p "$(dirname "$target_dir")"
  mv "$staged_target" "$target_dir"
  rm -rf "$staging_dir"

  print_success "Checked $label: updated"
  return 0
}

get_config_value() {
  local key="$1"

  # Return default if no config file exists
  if [ ! -f "$PROJECT_CONFIG_FILE" ]; then
    case "$key" in
      skillsRepo) echo "$DEFAULT_SKILLS_REPO" ;;
      *) echo "" ;;
    esac
    return
  fi

  # Try to read from config file
  if command -v jq &> /dev/null; then
    jq -r ".\"$key\" // empty" "$PROJECT_CONFIG_FILE" 2>/dev/null || echo ""
  else
    grep "\"$key\"" "$PROJECT_CONFIG_FILE" | sed 's/.*": "\(.*\)".*/\1/' || echo ""
  fi
}

set_config_value() {
  local key="$1"
  local value="$2"

  # Create empty config if it doesn't exist
  if [ ! -f "$PROJECT_CONFIG_FILE" ]; then
    echo "{}" > "$PROJECT_CONFIG_FILE"
  fi

  # Update config file
  if command -v jq &> /dev/null; then
    jq ".\"$key\" = \"$value\"" "$PROJECT_CONFIG_FILE" > "${PROJECT_CONFIG_FILE}.tmp" && mv "${PROJECT_CONFIG_FILE}.tmp" "$PROJECT_CONFIG_FILE"
  else
    # Fallback: simple sed replacement or append
    if grep -q "\"$key\"" "$PROJECT_CONFIG_FILE"; then
      sed -i '' "s/\"$key\": \"[^\"]*\"/\"$key\": \"$value\"/" "$PROJECT_CONFIG_FILE"
    else
      sed -i '' '$ s/}/,"'$key'": "'$value'"}/' "$PROJECT_CONFIG_FILE"
    fi
  fi

  print_success "Config saved: $key = $value"
}

# Download file from GitHub with strict error handling
# Usage: github_download <skills_repo> <file_path> <output_file> <allow_stub>
# allow_stub: if 'true', fail fast on error; if 'false', skip on error
github_download() {
  local skills_repo="$1"
  local file_path="$2"
  local output_file="$3"
  local allow_stub="$4"
  local raw_url
  local temp_file
  
  raw_url=$(github_raw_url "$skills_repo" "$file_path")
  temp_file=$(mktemp)
  
  if curl -sf "$raw_url" > "$temp_file" 2>/dev/null; then
    mv "$temp_file" "$output_file"
    print_success "Downloaded $file_path"
    return 0
  else
    rm -f "$temp_file"
    if [ "$allow_stub" = "true" ]; then
      print_error "Failed to download $file_path from $skills_repo"
      print_error "Cannot initialize project without critical files"
      return 1
    else
      print_warn "Could not download $file_path; skipping update"
      return 2
    fi
  fi
}

create_constitution_if_missing() {
  if [ ! -f ".github/AI_CONSTITUTION.md" ]; then
    if ! update_constitution; then
      print_error "AI_CONSTITUTION.md is required for initialization"
      exit 1
    fi
  fi
}

create_initialization_if_missing() {
  if [ ! -f ".github/AI_INITIALIZATION.md" ]; then
    if ! update_initialization; then
      print_error "AI_INITIALIZATION.md is required for initialization"
      exit 1
    fi
  fi
}

update_constitution() {
  local skills_repo
  local snapshot_root="$1"
  local target_file=".github/AI_CONSTITUTION.md"
  local bundled_file="$SCRIPT_DIR/.github/AI_CONSTITUTION.md"

  if [ -z "$snapshot_root" ]; then
    skills_repo=$(get_config_value "skillsRepo")
    if ensure_repo_snapshot "$skills_repo"; then
      snapshot_root="$REPO_SNAPSHOT_ROOT"
    fi
  fi

  if [ -n "$snapshot_root" ] && [ -d "$snapshot_root" ]; then
    sync_file_if_changed "$snapshot_root/.github/AI_CONSTITUTION.md" "$target_file" "$target_file"
    return $?
  fi

  if [ -s "$target_file" ]; then
    print_warn "Could not check $target_file from remote; keeping local file"
    return 1
  fi

  if [ -s "$bundled_file" ]; then
    sync_file_if_changed "$bundled_file" "$target_file" "$target_file"
    if [ $? -eq 0 ]; then
      print_warn "Remote unavailable; restored $target_file from local template"
      return 0
    fi
    return 2
  fi

  print_warn "Could not check $target_file from remote and no local template found"
  return 1
}

update_initialization() {
  local skills_repo
  local snapshot_root="$1"
  local target_file=".github/AI_INITIALIZATION.md"
  local bundled_file="$SCRIPT_DIR/.github/AI_INITIALIZATION.md"

  if [ -z "$snapshot_root" ]; then
    skills_repo=$(get_config_value "skillsRepo")
    if ensure_repo_snapshot "$skills_repo"; then
      snapshot_root="$REPO_SNAPSHOT_ROOT"
    fi
  fi

  if [ -n "$snapshot_root" ] && [ -d "$snapshot_root" ]; then
    sync_file_if_changed "$snapshot_root/.github/AI_INITIALIZATION.md" "$target_file" "$target_file"
    return $?
  fi

  if [ -s "$target_file" ]; then
    print_warn "Could not check $target_file from remote; keeping local file"
    return 1
  fi

  if [ -s "$bundled_file" ]; then
    sync_file_if_changed "$bundled_file" "$target_file" "$target_file"
    if [ $? -eq 0 ]; then
      print_warn "Remote unavailable; restored $target_file from local template"
      return 0
    fi
    return 2
  fi

  print_warn "Could not check $target_file from remote and no local template found"
  return 1
}

